</main>

<script>
const notes=[
 ["A LITTLE CONFESSION","If someone told me a month ago that one person would become such a big part of my everyday life, I would've laughed. And then u happened. 💗"],
 ["YOUR UNFAIR ADVANTAGE","It's actually so annoying how u can make me smile at my screen just by replying. Like sir, who gave u this power???"],
 ["A TINY PROMISE","I can't promise that every day will be perfect, but I can promise to be there for u in every step."],
 ["EXPOSING MYSELF","Not me thinking about our first meeting every day 😁😁"],
 ["FOR MY PATIDEV","Happy one month, patidev. U are officially stuck with this overthinking, clingy, attitude-filled girl who likes u an unreasonable amount. Congratulations 😁💗"]
];
const coupons=[
 ["THE ATTENTION TAX","Congratulations hubby! You've officially claimed my undivided attention. No distractions, just me and you. Hehe 🤭"],
 ["STUPID FIGHT CANCELLATION","One free cancellation for a stupid fight. Redeem when needed. We talk it out, okay? ♡"],
 ["MYSTERY REWARD","Congratulations u got a clingy wife with attitude she learnt from K-dramas 😁"],
 ["THE FINAL BOSS ♛","Congratulations hubby, u have to watch unlimited K-dramas with me 😁💗"]
];
let xp=0,completed=new Set(),seenNotes=new Set(),usedCoupons=new Set();
let candlesBlown=false,sliceMoved=false,toastTimer;
const $=id=>document.getElementById(id);

function go(id){
 const current=document.querySelector('.screen.active');
 if(current && current.id===id)return;
 if(current){
  current.style.animation='screenOut .18s steps(4) forwards';
  setTimeout(()=>{
   current.classList.remove('active');current.style.animation='';
   showScreen(id);
  },150);
 }else showScreen(id);
}
function showScreen(id){
 document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));
 const target=$(id);
 if(target){target.classList.add('active');window.scrollTo({top:0,behavior:'smooth'})}
 if(id==='final')updateRank();
}
function updateStats(){
 $('xp').textContent=xp;
 $('level').textContent=xp>=60?'02':'01';
 $('hearts').textContent='♡'.repeat(Math.min(5,3+Math.floor(xp/30)));
 const percent=Math.min(100,Math.round(completed.size/4*100));
 $('progressFill').style.width=percent+'%';
 $('progressText').textContent='QUEST PROGRESS: '+percent+'%';
}
function completeQuest(id,points,message){
 if(completed.has(id))return popup('ALREADY COMPLETED!','This quest is already in your inventory, gamer. 😌');
 completed.add(id);xp+=points;
 $(id).classList.add('done');$(id).textContent='☑ '+$(id).textContent.slice(2);
 updateStats();toast(message+' +'+points+' XP');
}
function openNote(i){
 $('noteBody').classList.add('show');
 $('noteBody').innerHTML='<b style="color:var(--pink)">♡ '+notes[i][0]+' ♡</b><p>'+notes[i][1]+'</p>';
 if(!seenNotes.has(i)){
  seenNotes.add(i);xp+=10;updateStats();
  $('q1').classList.add('done');$('q1').textContent='☑ QUEST 1: Open a love note. +10 XP';
  toast('SECRET NOTE UNLOCKED! +10 XP 💗');
 }
 document.querySelectorAll('#noteGrid .tile').forEach((el,n)=>{
  if(n===i)el.classList.add('unlocked');
 });
}
function openCoupon(i){
 $('couponBody').classList.add('show');
 $('couponBody').innerHTML='<b style="color:var(--yellow)">🎟 '+coupons[i][0]+'</b><p>'+coupons[i][1]+'</p>'+
 '<button class="pixelbtn green" onclick="redeem('+i+')">REDEEM THIS COUPON ♡</button>';
}
function redeem(i){
 if(usedCoupons.has(i))return popup('COUPON ALREADY USED!','This coupon has officially been redeemed. No refunds, only hugs and negotiations. 😌');
 usedCoupons.add(i);xp+=10;updateStats();
 $('q3').classList.add('done');$('q3').textConte
