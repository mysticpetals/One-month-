    <button class="tile" onclick="openNote(2)"><span class="emoji">🌱</span>03<br>A TINY PROMISE</button>
    <button class="tile" onclick="openNote(3)"><span class="emoji">👀</span>04<br>EXPOSING MYSELF</button>
    <button class="tile" onclick="openNote(4)" style="grid-column:1/-1"><span class="emoji">👑</span>05<br>FOR MY PATIDEV</button>
   </div>
   <div id="noteBody" class="noteBody" aria-live="polite"></div>
   <button class="pixelbtn" onclick="go('letter')">NEXT: THE LETTER 💌</button>
   <button class="pixelbtn dark" onclick="go('quests')">◀ QUEST BOARD</button>
