 </section>

 <!-- SCREEN 5 -->
 <section class="screen" id="cake">
  <div class="pixelbox">
   <h2>🎂 THE CAKE QUEST 🎂</h2>
   <p>A cake has appeared. The candles are being dramatic.</p>
   <div id="cakeArea" role="button" tabindex="0" aria-label="Tap the cake to blow out candles">
